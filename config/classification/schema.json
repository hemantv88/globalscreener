    }
  },
  "mapping_fields": [
    "market",
    "sym",
    "isin",
    "classification_source",
    "classification_version",
    "macro_economic_sector",
    "macro_code",
    "sector",
    "sector_code",
    "industry",
    "industry_code",
    "basic_industry",
    "basic_industry_code",
    "mapping_status",
    "effective_from",
    "effective_to",
    "verified_on",
    "evidence_ref"
