  "mapping_status": [
    "verified",
    "inferred",
    "unmapped",
    "historical"
  ],
  "policy": {
    "production_requires": "verified",
    "preserve_exact_narrow_mappings": true,
    "never_guess_missing_levels": true,
    "keep_classification_separate_from_instrument_eligibility": true
  },
  "nse_reference": {
    "structure": "4-tier",
    "counts": {
      "macro_economic_sectors": 12,
      "sectors": 22,
      "industries": 59,
      "basic_industries": 197
    },
    "source": "NSE Indices Industry Classification Structure, July 2023",
