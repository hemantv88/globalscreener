  "market_adapters": {
    "IN": {
      "levels": [
        {
          "field": "macro_economic_sector",
          "codeField": "macro_code"
        },
        {
          "field": "sector",
          "codeField": "sector_code"
        },
        {
          "field": "industry",
          "codeField": "industry_code"
        },
        {
          "field": "basic_industry",
          "codeField": "basic_industry_code"
